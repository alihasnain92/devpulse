# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL 16 via Docker Compose)
DATABASE_URL=postgresql://devpulse:devpulse_secret@localhost:5433/devpulse?schema=public

# Queue & Cache (Redis 7 via Docker Compose)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate strong random secrets in production)
JWT_ACCESS_SECRET=devpulse_super_secret_access_key_change_me_in_prod
JWT_REFRESH_SECRET=devpulse_super_secret_refresh_key_change_me_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
