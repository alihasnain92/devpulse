# Application Environment
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Database (PostgreSQL 16 via Docker Compose on port 5433)
# Development Database
DATABASE_URL=postgresql://devpulse:devpulse_secret@localhost:5433/devpulse?schema=public
# Dedicated Test Database (Isolated from development data)
TEST_DATABASE_URL=postgresql://devpulse:devpulse_secret@localhost:5433/devpulse_test?schema=public

# Queue & Cache (Redis 7 via Docker Compose on port 6379)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets (Must be changed in production)
JWT_SECRET=devpulse_super_secret_access_key_change_me_in_prod
JWT_ACCESS_SECRET=devpulse_super_secret_access_key_change_me_in_prod
JWT_REFRESH_SECRET=devpulse_super_secret_refresh_key_change_me_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Webhook Signing Secret Encryption (AES-256-GCM, 32-byte / 64-hex character key)
WEBHOOK_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email & Notification Delivery Configuration
EMAIL_PROVIDER=smtp # Set to 'disabled' to turn off outbound emails
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=DevPulse Alerts <alerts@devpulse.dev>
APP_BASE_URL=http://localhost:3000
