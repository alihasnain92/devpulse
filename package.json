{
  "name": "devpulse",
  "version": "0.1.0",
  "private": true,
  "description": "DevPulse — API Uptime Monitoring and Incident Management Platform",
  "scripts": {
    "predev": "pnpm --filter @devpulse/api build",
    "dev": "concurrently -k --kill-others-on-fail -n \"web,api,worker\" -c \"cyan,blue,magenta\" \"pnpm --filter web dev\" \"pnpm --filter api start:dev\" \"pnpm --filter api start:worker:dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api start:dev",
    "dev:worker": "pnpm --filter api start:worker:dev",
    "dev:services": "docker compose up -d",
    "dev:services:down": "docker compose down",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/jest": "^29.5.14",
    "concurrently": "^9.1.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "jest": "^29.7.0",
    "prisma": "^7.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "packageManager": "pnpm@12.15.0"
}
