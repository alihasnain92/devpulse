datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "./generated/client"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

enum HttpMethod {
  GET
  HEAD
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String
  hashedPassword String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  monitors         Monitor[]
  refreshSessions  RefreshSession[]
  webhookEndpoints WebhookEndpoint[]
  apiKeys          ApiKey[]
  webhookEvents    WebhookEvent[]
  notificationPreference NotificationPreference?
  notifications          Notification[]
  emailDeliveries        NotificationEmailDelivery[]

  @@map("users")
}

model RefreshSession {
  id                 String    @id @default(uuid())
  userId             String
  hashedRefreshToken String    @unique
  familyId           String
  expiresAt          DateTime
  isRevoked          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model Monitor {
  id              String        @id @default(uuid())
  userId          String
  name            String
  url             String
  method          HttpMethod    @default(GET)
  intervalSeconds Int           @default(60)
  timeoutMs       Int           @default(10000)
  expectedStatus  Int           @default(200)
  isPaused        Boolean       @default(false)
  isSeeded        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults    CheckResult[]
  incidents       Incident[]

  @@index([userId])
  @@map("monitors")
}

model CheckResult {
  id           String    @id @default(uuid())
  monitorId    String
  statusCode   Int?
  latencyMs    Int
  isSuccess    Boolean
  errorMessage String?
  isSeeded     Boolean   @default(false)
  jobId        String?   @unique
  checkedAt    DateTime  @default(now())

  monitor      Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@map("check_results")
}

model Incident {
  id           String    @id @default(uuid())
  monitorId    String
  startedAt    DateTime  @default(now())
  resolvedAt   DateTime?
  cause        String
  isResolved   Boolean   @default(false)
  isSeeded     Boolean   @default(false)

  monitor      Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, isResolved])
  @@map("incidents")
}

model WebhookEndpoint {
  id              String   @id @default(uuid())
  userId          String
  name            String
  url             String
  description     String?
  events          String[]
  isEnabled       Boolean  @default(true)
  encryptedSecret String
  deletedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries      WebhookDelivery[]

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("webhook_endpoints")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  keyPrefix  String
  hashedKey  String    @unique
  scopes     String[]
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@map("api_keys")
}

model WebhookEvent {
  id         String   @id @default(uuid())
  userId     String
  type       String
  sourceType String
  sourceId   String
  dedupeKey  String   @unique
  payload    Json
  createdAt  DateTime @default(now())

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  outbox     WebhookOutbox?
  deliveries WebhookDelivery[]
  notifications   Notification[]
  emailDeliveries NotificationEmailDelivery[]

  @@index([userId])
  @@index([createdAt])
  @@map("webhook_events")
}

model WebhookOutbox {
  id           String    @id @default(uuid())
  eventId      String    @unique
  status       String    @default("PENDING")
  attemptCount Int       @default(0)
  availableAt  DateTime  @default(now())
  claimedAt    DateTime?
  queuedAt     DateTime?
  lastError    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  event        WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, claimedAt])
  @@map("webhook_outbox")
}

model WebhookDelivery {
  id                   String    @id @default(uuid())
  eventId              String
  endpointId           String
  endpointName         String
  destinationUrl       String
  origin               String    @default("AUTOMATIC")
  replayOfId           String?
  replayIdempotencyKey String?
  status               String    @default("PENDING")
  attemptCount         Int       @default(0)
  claimedAt            DateTime?
  nextAttemptAt        DateTime?
  deliveredAt          DateTime?
  lastHttpStatus       Int?
  lastErrorCode        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  event                WebhookEvent      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint             WebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Restrict)
  replayOf             WebhookDelivery?  @relation("WebhookDeliveryReplay", fields: [replayOfId], references: [id], onDelete: SetNull)
  replays              WebhookDelivery[] @relation("WebhookDeliveryReplay")
  attempts             WebhookAttempt[]

  @@index([endpointId])
  @@index([endpointId, createdAt])
  @@index([status, createdAt])
  @@index([origin, createdAt])
  @@index([replayOfId])
  @@index([replayIdempotencyKey])
  @@index([createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
  @@map("webhook_deliveries")
}

model WebhookAttempt {
  id              String    @id @default(uuid())
  deliveryId      String
  attemptNumber   Int
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  durationMs      Int?
  httpStatus      Int?
  outcome         String    @default("STARTED")
  errorCode       String?
  responsePreview String?
  createdAt       DateTime  @default(now())

  delivery        WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId])
  @@map("webhook_attempts")
}

model NotificationPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  inAppIncidentCreated  Boolean  @default(true)
  inAppIncidentResolved Boolean  @default(true)
  emailIncidentCreated  Boolean  @default(false)
  emailIncidentResolved Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model Notification {
  id         String    @id @default(uuid())
  userId     String
  eventId    String
  type       String
  title      String
  message    String
  incidentId String?
  monitorId  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  event      WebhookEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationEmailDelivery {
  id               String                   @id @default(uuid())
  userId           String
  eventId          String
  toEmail          String
  subject          String
  bodyText         String
  bodyHtml         String
  status           String                   @default("PENDING")
  attemptCount     Int                      @default(0)
  claimedAt        DateTime?
  nextAttemptAt    DateTime?
  deliveredAt      DateTime?
  lastErrorCode    String?
  lastErrorMessage String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  user             User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event            WebhookEvent             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  outbox           NotificationEmailOutbox?

  @@unique([userId, eventId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, nextAttemptAt])
  @@index([status, claimedAt])
  @@map("notification_email_deliveries")
}

model NotificationEmailOutbox {
  id           String                    @id @default(uuid())
  deliveryId   String                    @unique
  status       String                    @default("PENDING")
  attemptCount Int                       @default(0)
  availableAt  DateTime                  @default(now())
  claimedAt    DateTime?
  lastError    String?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  delivery     NotificationEmailDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@index([status, claimedAt])
  @@map("notification_email_outbox")
}
