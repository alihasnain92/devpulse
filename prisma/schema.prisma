datasource db {
  provider = "postgresql"
}

generator client {
  provider            = "prisma-client"
  output              = "./generated/client"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

enum HttpMethod {
  GET
  HEAD
}

model User {
  id             String           @id @default(uuid())
  email          String           @unique
  name           String
  hashedPassword String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  monitors         Monitor[]
  refreshSessions  RefreshSession[]
  webhookEndpoints WebhookEndpoint[]
  apiKeys          ApiKey[]

  @@map("users")
}

model RefreshSession {
  id                 String    @id @default(uuid())
  userId             String
  hashedRefreshToken String    @unique
  familyId           String
  expiresAt          DateTime
  isRevoked          Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_sessions")
}

model Monitor {
  id              String        @id @default(uuid())
  userId          String
  name            String
  url             String
  method          HttpMethod    @default(GET)
  intervalSeconds Int           @default(60)
  timeoutMs       Int           @default(10000)
  expectedStatus  Int           @default(200)
  isPaused        Boolean       @default(false)
  isSeeded        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkResults    CheckResult[]
  incidents       Incident[]

  @@index([userId])
  @@map("monitors")
}

model CheckResult {
  id           String    @id @default(uuid())
  monitorId    String
  statusCode   Int?
  latencyMs    Int
  isSuccess    Boolean
  errorMessage String?
  isSeeded     Boolean   @default(false)
  jobId        String?   @unique
  checkedAt    DateTime  @default(now())

  monitor      Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt])
  @@map("check_results")
}

model Incident {
  id           String    @id @default(uuid())
  monitorId    String
  startedAt    DateTime  @default(now())
  resolvedAt   DateTime?
  cause        String
  isResolved   Boolean   @default(false)
  isSeeded     Boolean   @default(false)

  monitor      Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, isResolved])
  @@map("incidents")
}

model WebhookEndpoint {
  id              String   @id @default(uuid())
  userId          String
  name            String
  url             String
  description     String?
  events          String[]
  isEnabled       Boolean  @default(true)
  encryptedSecret String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webhook_endpoints")
}

model ApiKey {
  id         String    @id @default(uuid())
  userId     String
  name       String
  keyPrefix  String
  hashedKey  String    @unique
  scopes     String[]
  isRevoked  Boolean   @default(false)
  revokedAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@map("api_keys")
}
